# Copy to .env before starting with Compose. Unraid's template sets these separately.
WEB_PORT=5800
BIND_ADDRESS=0.0.0.0
USER_ID=99
GROUP_ID=100
TZ=America/Los_Angeles
CONFIG_DIR=/mnt/user/appdata/buzz
INPUT_DIR=/mnt/user/transcription-input
UPLOAD_DIR=/mnt/user/transcription-uploads
OUTPUT_DIR=/mnt/user/transcriptions
# GPU index or UUID for Compose; the Unraid template uses NVIDIA_VISIBLE_DEVICES.
NVIDIA_GPU_DEVICE=0
